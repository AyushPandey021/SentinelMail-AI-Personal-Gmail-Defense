NODE_ENV=development
APP_BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173

MONGO_INITDB_ROOT_USERNAME=sentinel
MONGO_INITDB_ROOT_PASSWORD=sentinel_dev_password
MONGODB_DB=sentinelmail
MONGODB_URI=mongodb://127.0.0.1:27017
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace_with_64_hex_chars_for_local_dev
JWT_REFRESH_SECRET=replace_with_64_hex_chars_for_local_dev
ACCESS_TOKEN_TTL=20m
REFRESH_TOKEN_TTL=14d

EMAIL_PROVIDER=gmail
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SECURE=true
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_FULL_SYNC=true

AI_SERVICE_URL=http://ai-service:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_ALERT_FROM=security@sentinelmail.local
